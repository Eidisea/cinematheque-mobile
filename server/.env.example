# Names of the server's environment variables — VALUES ARE NEVER WRITTEN HERE.
# Set them in the Vercel dashboard: Project → Settings → Environment Variables.

# Firebase Admin: the service-account JSON, base64-encoded (Firebase console →
# Project settings → Service accounts → Generate new private key).
FIREBASE_SERVICE_ACCOUNT=

# Browser origins allowed to call the API (the staff web app), comma-separated.
ALLOWED_ORIGINS=

# PayMongo (test mode): secret key sk_test_… and the webhook's signing secret whsk_…
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Shared secret that cron-job.org sends to the expiry endpoint.
CRON_SECRET=
