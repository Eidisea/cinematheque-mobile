<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash screen — warm paper and the Cinematheque mark. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ccd_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowBackground">@color/ccd_paper</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ccd_paper</item>
    </style>
</resources>
