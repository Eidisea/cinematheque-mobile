<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: adaptive launcher icon (the gold CD mark on cinema-dark).
     Layers are rendered from tool/icon/ccd_mark.svg.html by tool/icon/render_icon.ps1.
     The mark stays inside the 66dp safe zone, so any launcher mask shape keeps it whole. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
