<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app process starts (Android 7–11). The app is light-only, so the
         same light theme is used whatever the phone's dark-mode setting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it runs: warm paper, never a white flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ccd_paper</item>
    </style>
</resources>
