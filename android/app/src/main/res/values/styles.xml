<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app process starts (Android 7–11). The app is light-only, so the
         same theme applies whatever the phone's dark-mode setting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI once it runs (the launch screen stays until Flutter's first
         frame, which is the intro): warm paper, like the app itself. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ccd_paper</item>
    </style>
</resources>
